# gitignore template for LangChain products, e.g., LangGraph, LangSmith
# website: https://www.langchain.com/
# website: https://www.langchain.com/langgraph

# LangGraph
.langgraph_api/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/

# Secrets / env
.env
.env.local
.streamlit/secrets.toml

# cached data to reduce latency and include
# data that can't be fetched during runtime
data/cache/fastf1_http_cache.sqlite*

# local testing
local/

# Vector store persistence
data/vectorstore/
data/chroma/

# OS
.DS_Store
